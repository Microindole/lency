// lencyc/codegen/lir.lcy
// Minimal LIR emitter for self-host pipeline.

import std.core
import std.convert
import lencyc.syntax.ast
import lencyc.codegen.lir.functions
import lencyc.codegen.lir.enum_support
import lencyc.codegen.lir.expr_call
import lencyc.codegen.lir.match_expr

struct LirBuilder {
    string out
    bool has_error
    int error_count
    int temp_counter
    int label_counter
    bool current_function_returns
    string current_function_name
    Vec<string> break_targets
    Vec<string> continue_targets
    int loop_depth
    Vec<string> enum_variant_enum_names
    Vec<string> enum_variant_names
    Vec<int> enum_variant_tags
    Vec<string> enum_payload_enum_names
    Vec<string> enum_payload_variant_names
    Vec<int> enum_payload_indices
    Vec<string> enum_payload_type_names
    Vec<string> enum_var_names
    Vec<string> enum_var_types
    Vec<string> typed_var_names
    Vec<string> typed_var_types
    Vec<string> declared_struct_type_names
    Vec<string> declared_enum_type_names
    Vec<string> struct_field_struct_names
    Vec<string> struct_field_names
    Vec<int> struct_field_indices
    Vec<string> struct_field_type_names
    Vec<string> function_names
    Vec<string> function_return_type_names
    Vec<int> function_param_counts
    Vec<string> function_param_names
    Vec<string> function_param_type_names
}

struct LirEmitResult {
    string text
    bool has_error
    int error_count
}

LirBuilder make_lir_builder() {
    return LirBuilder {
        out: "",
        has_error: false,
        error_count: 0,
        temp_counter: 0,
        label_counter: 0,
        current_function_returns: false,
        current_function_name: "",
        break_targets: vec![],
        continue_targets: vec![],
        loop_depth: 0,
        enum_variant_enum_names: vec![],
        enum_variant_names: vec![],
        enum_variant_tags: vec![],
        enum_payload_enum_names: vec![],
        enum_payload_variant_names: vec![],
        enum_payload_indices: vec![],
        enum_payload_type_names: vec![],
        enum_var_names: vec![],
        enum_var_types: vec![],
        typed_var_names: vec![],
        typed_var_types: vec![],
        declared_struct_type_names: vec![],
        declared_enum_type_names: vec![],
        struct_field_struct_names: vec![],
        struct_field_names: vec![],
        struct_field_indices: vec![],
        struct_field_type_names: vec![],
        function_names: vec![],
        function_return_type_names: vec![],
        function_param_counts: vec![],
        function_param_names: vec![],
        function_param_type_names: vec![]
    }
}
LirEmitResult emit_lir_program(Vec<Stmt> statements) {
    var builder = make_lir_builder()
    builder.preload_enum_metadata(statements)
    builder.preload_struct_metadata(statements)
    builder.preload_function_metadata(statements)
    builder.emit_line("; lencyc-lir v0")
    builder.emit_main_function(statements)
    builder.emit_user_functions(statements)
    var emitted_text = builder.out
    if builder.has_error {
        emitted_text = ""
    }
    return LirEmitResult {
        text: emitted_text,
        has_error: builder.has_error,
        error_count: builder.error_count
    }
}

impl LirBuilder {
    void error(string message) {
        this.has_error = true
        this.error_count = this.error_count + 1
        var location = ""
        if this.current_function_name != "" {
            location = " in " + this.current_function_name
        }
        print("[lencyc/lir] Error" + location + ": " + message + "\n")
    }

    void emit_line(string line) {
        this.out = this.out + line + "\n"
    }

    string new_temp() {
        var name = "%t" + int_to_string(this.temp_counter)
        this.temp_counter = this.temp_counter + 1
        return name
    }

    string new_label(string prefix) {
        var label = prefix + "_" + int_to_string(this.label_counter)
        this.label_counter = this.label_counter + 1
        return label
    }

    void push_loop_targets(string break_label, string continue_label) {
        this.break_targets.push(break_label)
        this.continue_targets.push(continue_label)
        this.loop_depth = this.loop_depth + 1
    }

    void pop_loop_targets() {
        if this.loop_depth > 0 {
            this.loop_depth = this.loop_depth - 1
        }
    }

    string current_break_target() {
        if this.loop_depth == 0 {
            return ""
        }
        return this.break_targets[this.loop_depth - 1]
    }

    string current_continue_target() {
        if this.loop_depth == 0 {
            return ""
        }
        return this.continue_targets[this.loop_depth - 1]
    }

    string binary_opcode(string op) {
        if op == "+" { return "add" }
        if op == "-" { return "sub" }
        if op == "*" { return "mul" }
        if op == "/" { return "div" }
        if op == "==" { return "cmp_eq" }
        if op == "!=" { return "cmp_ne" }
        if op == "<" { return "cmp_lt" }
        if op == "<=" { return "cmp_le" }
        if op == ">" { return "cmp_gt" }
        if op == ">=" { return "cmp_ge" }
        if op == "&&" { return "and" }
        if op == "||" { return "or" }
        this.error("unsupported binary operator: " + op)
        return ""
    }

    string binary_opcode_for_expr(Expr expr) {
        var op = expr.operator.lexeme
        if op == "+" {
            var lhs_add_ty = ""
            var rhs_add_ty = ""
            if expr.children.len() > 0 {
                lhs_add_ty = this.infer_expr_type_name(expr.children[0])
            }
            if expr.children.len() > 1 {
                rhs_add_ty = this.infer_expr_type_name(expr.children[1])
            }
            if lhs_add_ty == "string" || rhs_add_ty == "string" {
                return "concat"
            }
        }
        if op == "==" || op == "!=" {
            var lhs_ty = ""
            var rhs_ty = ""
            if expr.children.len() > 0 {
                lhs_ty = this.infer_expr_type_name(expr.children[0])
            }
            if expr.children.len() > 1 {
                rhs_ty = this.infer_expr_type_name(expr.children[1])
            }
            if lhs_ty == "string" || rhs_ty == "string" {
                if op == "==" {
                    return "cmp_str_eq"
                }
                return "cmp_str_ne"
            }
        }
        return this.binary_opcode(op)
    }

    string unary_opcode(string op) {
        if op == "-" { return "neg" }
        if op == "!" { return "not" }
        this.error("unsupported unary operator: " + op)
        return ""
    }

    string join_args(Vec<string> args) {
        var out = ""
        var i = 0
        while i < args.len() {
            out = out + args[i]
            if i + 1 < args.len() {
                out = out + ", "
            }
            i = i + 1
        }
        return out
    }

    void emit_stmt_list(Vec<Stmt> statements) {
        var i = 0
        while i < statements.len() {
            this.emit_stmt(statements[i])
            i = i + 1
        }
    }
    void emit_stmt(Stmt stmt) {
        if stmt.kind == STMT_VAR_DECL() {
            var init_val = this.emit_expr(stmt.expr)
            this.emit_line("  var %" + stmt.name.lexeme + " = " + init_val)
            var enum_name = this.infer_expr_enum_name(stmt.expr)
            var type_name = this.infer_expr_type_name(stmt.expr)
            if enum_name != "" {
                this.track_enum_variable(stmt.name.lexeme, enum_name)
            } else {
                this.clear_enum_variable(stmt.name.lexeme)
            }
            if type_name != "" {
                this.track_typed_variable(stmt.name.lexeme, type_name)
            } else {
                this.clear_typed_variable(stmt.name.lexeme)
            }
            return
        }
        if stmt.kind == STMT_EXPR() {
            var unused = this.emit_expr(stmt.expr)
            return
        }
        if stmt.kind == STMT_RETURN() {
            var val = this.emit_expr(stmt.expr)
            this.emit_line("  ret " + val)
            this.current_function_returns = true
            return
        }
        if stmt.kind == STMT_RETURN_VOID() {
            this.emit_line("  ret")
            this.current_function_returns = true
            return
        }
        if stmt.kind == STMT_BLOCK() {
            this.emit_stmt_list(stmt.body)
            return
        }
        if stmt.kind == STMT_IF() {
            var then_label = this.new_label("if_then")
            var else_label = this.new_label("if_else")
            var end_label = this.new_label("if_end")

            var cond = this.emit_expr(stmt.expr)
            this.emit_line("  br " + cond + ", " + then_label + ", " + else_label)
            this.emit_line(then_label + ":")
            this.emit_stmt_list(stmt.body)
            this.emit_line("  jmp " + end_label)
            this.emit_line(else_label + ":")
            this.emit_stmt_list(stmt.else_body)
            this.emit_line("  jmp " + end_label)
            this.emit_line(end_label + ":")
            return
        }
        if stmt.kind == STMT_WHILE() {
            var cond_label = this.new_label("while_cond")
            var body_label = this.new_label("while_body")
            var end_label = this.new_label("while_end")

            this.emit_line("  jmp " + cond_label)
            this.emit_line(cond_label + ":")
            var cond = this.emit_expr(stmt.expr)
            this.emit_line("  br " + cond + ", " + body_label + ", " + end_label)
            this.emit_line(body_label + ":")
            this.push_loop_targets(end_label, cond_label)
            this.emit_stmt_list(stmt.body)
            this.pop_loop_targets()
            this.emit_line("  jmp " + cond_label)
            this.emit_line(end_label + ":")
            return
        }
        if stmt.kind == STMT_BREAK() {
            var break_label = this.current_break_target()
            if break_label == "" {
                this.error("break has no loop target")
            } else {
                this.emit_line("  jmp " + break_label)
            }
            return
        }
        if stmt.kind == STMT_CONTINUE() {
            var continue_label = this.current_continue_target()
            if continue_label == "" {
                this.error("continue has no loop target")
            } else {
                this.emit_line("  jmp " + continue_label)
            }
            return
        }
        if stmt.kind == STMT_STRUCT() || stmt.kind == STMT_FUNCTION() || stmt.kind == STMT_IMPL() || stmt.kind == STMT_IMPORT() || stmt.kind == STMT_EXTERN() || stmt.kind == STMT_ENUM() {
            return
        }
        this.error("unsupported statement kind: " + int_to_string(stmt.kind))
    }
    string emit_expr(Expr expr) {
        if expr.kind == EXPR_LITERAL() {
            return expr.literal_value.lexeme
        }
        if expr.kind == EXPR_VARIABLE() {
            return "%" + expr.literal_value.lexeme
        }
        if expr.kind == EXPR_GROUPING() {
            if expr.children.len() == 0 {
                return "0"
            }
            return this.emit_expr(expr.children[0])
        }
        if expr.kind == EXPR_ASSIGN() {
            var val = "0"
            if expr.children.len() > 0 {
                val = this.emit_expr(expr.children[0])
            }
            this.emit_line("  store %" + expr.literal_value.lexeme + ", " + val)
            var enum_name = ""
            var type_name = ""
            if expr.children.len() > 0 {
                enum_name = this.infer_expr_enum_name(expr.children[0])
                type_name = this.infer_expr_type_name(expr.children[0])
            }
            if enum_name != "" {
                this.track_enum_variable(expr.literal_value.lexeme, enum_name)
            } else {
                this.clear_enum_variable(expr.literal_value.lexeme)
            }
            if type_name != "" {
                this.track_typed_variable(expr.literal_value.lexeme, type_name)
            } else {
                this.clear_typed_variable(expr.literal_value.lexeme)
            }
            return val
        }
        if expr.kind == EXPR_SET() {
            if expr.children.len() < 2 {
                return "0"
            }
            var object_val = this.emit_expr(expr.children[0])
            var value_val = this.emit_expr(expr.children[1])
            var struct_name = this.infer_expr_type_name(expr.children[0])
            var field_index = this.lookup_struct_field_index(struct_name, expr.literal_value.lexeme)
            this.emit_line("  call %lency_vec_set(" + object_val + ", " + int_to_string(field_index) + ", " + value_val + ")")
            return value_val
        }
        if expr.kind == EXPR_UNARY() {
            var rhs = "0"
            if expr.children.len() > 0 {
                rhs = this.emit_expr(expr.children[0])
            }
            var opcode = this.unary_opcode(expr.operator.lexeme)
            if opcode == "" {
                return "0"
            }
            var dst = this.new_temp()
            this.emit_line("  " + dst + " = " + opcode + " " + rhs)
            return dst
        }
        if expr.kind == EXPR_BINARY() || expr.kind == EXPR_LOGICAL() {
            var lhs = "0"
            var rhs = "0"
            if expr.children.len() > 0 {
                lhs = this.emit_expr(expr.children[0])
            }
            if expr.children.len() > 1 {
                rhs = this.emit_expr(expr.children[1])
            }
            var opcode = this.binary_opcode_for_expr(expr)
            if opcode == "" {
                return "0"
            }
            var dst = this.new_temp()
            this.emit_line("  " + dst + " = " + opcode + " " + lhs + ", " + rhs)
            return dst
        }
        if expr.kind == EXPR_GET() {
            if expr.children.len() > 0 {
                var object_ty = this.infer_expr_type_name(expr.children[0])
                var field_index = this.lookup_struct_field_index(object_ty, expr.literal_value.lexeme)
                if field_index >= 0 {
                    var obj = this.emit_expr(expr.children[0])
                    var dst_struct = this.new_temp()
                    this.emit_line("  " + dst_struct + " = call %lency_vec_get(" + obj + ", " + int_to_string(field_index) + ")")
                    return dst_struct
                }
            }
            var obj = "?"
            if expr.children.len() > 0 {
                obj = this.emit_expr(expr.children[0])
            }
            var dst = this.new_temp()
            this.emit_line("  " + dst + " = get " + obj + "." + expr.literal_value.lexeme)
            return dst
        }
        if expr.kind == EXPR_STRUCT() {
            var dst_struct_new = this.new_temp()
            this.emit_line("  " + dst_struct_new + " = call %lency_vec_new(" + int_to_string(expr.field_names.len()) + ")")
            var current = dst_struct_new
            var i = 0
            while i < expr.field_names.len() && i < expr.children.len() {
                var field_value = this.emit_expr(expr.children[i])
                this.emit_line("  call %lency_vec_push(" + current + ", " + field_value + ")")
                i = i + 1
            }
            return current
        }
        if expr.kind == EXPR_VEC() {
            var dst_vec = this.new_temp()
            this.emit_line("  " + dst_vec + " = call %lency_vec_new(" + int_to_string(expr.children.len()) + ")")
            var i = 0
            while i < expr.children.len() {
                var element = this.emit_expr(expr.children[i])
                this.emit_line("  call %lency_vec_push(" + dst_vec + ", " + element + ")")
                i = i + 1
            }
            return dst_vec
        }
        if expr.kind == EXPR_CALL() {
            return this.emit_expr_call(expr)
        }
        if expr.kind == EXPR_MATCH() {
            return this.emit_expr_match(expr)
        }
        this.error("unsupported expression kind: " + int_to_string(expr.kind))
        return "0"
    }
}
