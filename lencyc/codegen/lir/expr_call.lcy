// lencyc/codegen/lir/expr_call.lcy
// Call-expression lowering helpers for self-host LIR emitter.

import std.core
import std.convert
import lencyc.syntax.ast
import lencyc.codegen.lir

impl LirBuilder {
    string emit_expr_call(Expr expr) {
        if expr.children.len() == 0 {
            this.error("call expression has no callee")
            return "0"
        }
        var enum_ctor_name = this.expr_callee_name(expr.children[0])
        var enum_ctor_owner = this.lookup_enum_name_by_variant(enum_ctor_name)
        if enum_ctor_owner != "" {
            var ctor_dst = this.new_temp()
            var ctor_tag = this.lookup_enum_tag_in(enum_ctor_owner, enum_ctor_name)
            this.emit_line("  " + ctor_dst + " = call %lency_enum_new0(" + int_to_string(ctor_tag) + ")")
            var arg_id = 1
            while arg_id < expr.children.len() {
                var push_tmp = this.new_temp()
                var arg_val = this.emit_expr(expr.children[arg_id])
                this.emit_line("  " + push_tmp + " = call %lency_enum_push(" + ctor_dst + ", " + arg_val + ")")
                ctor_dst = push_tmp
                arg_id = arg_id + 1
            }
            return ctor_dst
        }
        var callee_expr = expr.children[0]
        if callee_expr.kind == EXPR_GET() && callee_expr.children.len() > 0 {
            var object_expr = callee_expr.children[0]
            var object_type = this.infer_expr_type_name(object_expr)
            var member_name = callee_expr.literal_value.lexeme
            if member_name == "index" {
                var index_runtime_name = "lency_vec_get"
                if object_type == "string" {
                    index_runtime_name = "lency_string_index"
                }
                var indexed_object = this.emit_expr(object_expr)
                var index_value = "0"
                if expr.children.len() > 1 {
                    index_value = this.emit_expr(expr.children[1])
                }
                var index_dst = this.new_temp()
                this.emit_line("  " + index_dst + " = call %" + index_runtime_name + "(" + indexed_object + ", " + index_value + ")")
                return index_dst
            }
            if member_name == "push" || member_name == "pop" || member_name == "get" || member_name == "set" || (member_name == "len" && object_type != "string") {
                var vec_runtime_name = "lency_vec_get"
                if member_name == "len" { vec_runtime_name = "lency_vec_len" }
                if member_name == "push" { vec_runtime_name = "lency_vec_push" }
                if member_name == "pop" { vec_runtime_name = "lency_vec_pop" }
                if member_name == "set" { vec_runtime_name = "lency_vec_set" }
                var vec_object = this.emit_expr(object_expr)
                var vec_args = vec[vec_object]
                var vec_arg_id = 1
                while vec_arg_id < expr.children.len() {
                    vec_args.push(this.emit_expr(expr.children[vec_arg_id]))
                    vec_arg_id = vec_arg_id + 1
                }
                var vec_dst = this.new_temp()
                this.emit_line("  " + vec_dst + " = call %" + vec_runtime_name + "(" + this.join_args(vec_args) + ")")
                return vec_dst
            }
            if object_type != "" && !this.is_vec_type_name(object_type) && object_type != "string" {
                var object_value = this.emit_expr(object_expr)
                var member_args = vec[object_value]
                var member_arg_id = 1
                while member_arg_id < expr.children.len() {
                    member_args.push(this.emit_expr(expr.children[member_arg_id]))
                    member_arg_id = member_arg_id + 1
                }
                var member_dst = this.new_temp()
                this.emit_line("  " + member_dst + " = call %" + object_type + "__" + member_name + "(" + this.join_args(member_args) + ")")
                return member_dst
            }
        }
        var callee = this.emit_expr(expr.children[0])
        Vec<string> args = vec[]
        var i = 1
        while i < expr.children.len() {
            args.push(this.emit_expr(expr.children[i]))
            i = i + 1
        }
        var dst = this.new_temp()
        this.emit_line("  " + dst + " = call " + callee + "(" + this.join_args(args) + ")")
        return dst
    }
}
