// lencyc/codegen/lir/functions.lcy
// Function-level LIR emission helpers split out to keep lir.lcy under meta limits.

import std.core
import lencyc.syntax.ast
import lencyc.codegen.lir

impl LirBuilder {
    void reset_function_state() {
        this.break_targets = vec[]
        this.continue_targets = vec[]
        this.loop_depth = 0
        this.enum_var_names = vec[]
        this.enum_var_types = vec[]
        this.typed_var_names = vec[]
        this.typed_var_types = vec[]
        this.current_function_returns = false
        this.current_function_name = ""
    }

    bool is_nullable_abi_type_name(string type_name) {
        if len(type_name) == 0 {
            return false
        }
        return type_name[len(type_name) - 1] == 63
    }

    string strip_nullable_abi_suffix(string type_name) {
        if this.is_nullable_abi_type_name(type_name) {
            return substr(type_name, 0, len(type_name) - 1)
        }
        return type_name
    }

    string abi_type_name(string type_name) {
        var concrete_name = this.strip_nullable_abi_suffix(type_name)
        if concrete_name == "void" && !this.is_nullable_abi_type_name(type_name) {
            return "void"
        }
        if this.is_nullable_abi_type_name(type_name) {
            if concrete_name == "int" || concrete_name == "float" || concrete_name == "bool" || concrete_name == "string" ||
               concrete_name == "char" || this.is_vec_type_name(concrete_name) ||
               this.is_enum_type_name(concrete_name) || this.has_struct_type(concrete_name) {
                return "ptr"
            }
            this.error("unknown nullable ABI type: " + type_name)
            return ""
        }
        if concrete_name == "string" || this.is_vec_type_name(concrete_name) {
            return "ptr"
        }
        if concrete_name == "bool" {
            return "i1"
        }
        if concrete_name == "null" {
            return "ptr"
        }
        if concrete_name == "int" || concrete_name == "float" || concrete_name == "char" {
            return "i64"
        }
        if this.is_enum_type_name(concrete_name) {
            return "ptr"
        }
        if this.has_struct_type(concrete_name) {
            return "ptr"
        }
        this.error("unknown ABI type: " + type_name)
        return ""
    }

    bool has_struct_type(string struct_name) {
        var i = this.declared_struct_type_names.len() - 1
        while i >= 0 {
            var declared_name = this.declared_struct_type_names[i]
            if declared_name == struct_name || starts_with(struct_name, declared_name + "<") {
                return true
            }
            i = i - 1
        }
        return false
    }

    void emit_function_header(string name, Vec<string> params, Vec<string> param_type_names, string return_type_name) {
        var signature = "func " + name + "("
        var i = 0
        while i < params.len() {
            signature = signature + "%" + params[i] + ": " + this.abi_type_name(param_type_names[i])
            if i + 1 < params.len() {
                signature = signature + ", "
            }
            i = i + 1
        }
        signature = signature + ") -> " + this.abi_type_name(return_type_name) + " {"
        this.emit_line(signature)
        this.emit_line("entry:")
    }

    void emit_main_function(Vec<Stmt> statements) {
        var f = 0
        while f < statements.len() {
            if statements[f].kind == STMT_FUNCTION() {
                var decl = stmt_to_decl(statements[f])
                if decl.name.lexeme == "main" {
                    return
                }
            }
            f = f + 1
        }
        this.reset_function_state()
        this.current_function_name = "main"
        this.emit_line("func main() -> i64 {")
        this.emit_line("entry:")
        var i = 0
        while i < statements.len() {
            if statements[i].kind != STMT_FUNCTION() {
                this.emit_stmt(statements[i])
            }
            i = i + 1
        }
        if !this.current_function_returns {
            this.emit_line("  ret 0")
        }
        this.emit_line("}")
    }

    void emit_user_functions(Vec<Stmt> statements) {
        var i = 0
        while i < statements.len() {
            if statements[i].kind == STMT_FUNCTION() {
                this.emit_function_decl(stmt_to_decl(statements[i]))
            }
            if statements[i].kind == STMT_IMPL() {
                var impl_decl = stmt_to_decl(statements[i])
                var m = 0
                while m < impl_decl.body.len() {
                    var member = stmt_to_decl(impl_decl.body[m])
                    if member.kind == DECL_FUNCTION() {
                        this.emit_method_decl(impl_decl.name.lexeme, member)
                    }
                    m = m + 1
                }
            }
            i = i + 1
        }
    }

    void emit_method_decl(string owner_name, Decl decl) {
        this.reset_function_state()
        this.current_function_name = owner_name + "__" + decl.name.lexeme
        var params = vec["this"]
        var param_types = vec[owner_name]
        var i = 0
        while i < decl.params.len() {
            params.push(decl.params[i])
            param_types.push(decl.param_types[i].name)
            i = i + 1
        }
        this.emit_function_header(this.current_function_name, params, param_types, decl.return_type.name)
        this.track_typed_variable("this", owner_name)
        i = 0
        while i < decl.params.len() {
            this.track_typed_variable(decl.params[i], decl.param_types[i].name)
            i = i + 1
        }
        this.emit_stmt_list(decl.body)
        if !this.current_function_returns {
            if decl.return_type.name == "void" {
                this.emit_line("  ret")
            } else {
                this.emit_line("  ret 0")
            }
        }
        this.emit_line("}")
    }

    void emit_function_decl(Decl decl) {
        this.reset_function_state()
        this.current_function_name = decl.name.lexeme
        this.emit_function_header(
            decl.name.lexeme,
            decl.params,
            this.extract_type_names(decl.param_types),
            decl.return_type.name
        )
        var i = 0
        while i < decl.params.len() {
            this.track_typed_variable(decl.params[i], decl.param_types[i].name)
            i = i + 1
        }
        this.emit_stmt_list(decl.body)
        if !this.current_function_returns {
            if decl.return_type.name == "void" {
                this.emit_line("  ret")
            } else {
                // TODO: 统一补齐无显式 return 的控制流诊断；当前 codegen 仅保底补一个默认返回。
                this.emit_line("  ret 0")
            }
        }
        this.emit_line("}")
    }

    Vec<string> extract_type_names(Vec<TypeRef> type_refs) {
        var names = vec[]
        var i = 0
        while i < type_refs.len() {
            names.push(type_refs[i].name)
            i = i + 1
        }
        return names
    }
}
