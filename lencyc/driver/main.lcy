// lencyc/driver/main.lcy
// 自举版 Lency 编译器入口

import std.core
import std.fs
import std.str
import lencyc.cli.args
import lencyc.syntax.token
import lencyc.syntax.lexer
import lencyc.syntax.parser
import lencyc.syntax.ast
import lencyc.sema.resolver
import lencyc.codegen.lir

string render_ast_program(Vec<Stmt> statements) {
    var out = ""
    var i = 0
    while i < statements.len() {
        out = out + "AST[" + int_to_string(i) + "]: " + stmt_to_string(statements[i]) + "\n"
        i = i + 1
    }
    return out
}

bool path_was_loaded(Vec<string> loaded_paths, string path) {
    var i = 0
    while i < loaded_paths.len() {
        if loaded_paths[i] == path {
            return true
        }
        i = i + 1
    }
    return false
}

string import_file_path(Stmt stmt) {
    var decl = stmt_to_decl(stmt)
    if decl.params.len() == 0 || decl.params[0] == "std" {
        return ""
    }
    var path = ""
    var i = 0
    while i < decl.params.len() {
        if i > 0 {
            path = path + "/"
        }
        path = path + decl.params[i]
        i = i + 1
    }
    return path + ".lcy"
}

Vec<Stmt> load_compilation_statements(string path, Vec<string> loaded_paths) {
    Vec<Stmt> out = vec[]
    if path_was_loaded(loaded_paths, path) {
        return out
    }
    loaded_paths.push(path)
    var parser = make_parser(read_to_string(path))
    var program = parser.parse_program()
    if parser.has_error {
        return out
    }
    var i = 0
    while i < program.statements.len() {
        var stmt = program.statements[i]
        if stmt.kind == STMT_IMPORT() {
            var imported_path = import_file_path(stmt)
            if imported_path != "" && file_exists(imported_path) {
                var imported = load_compilation_statements(imported_path, loaded_paths)
                var j = 0
                while j < imported.len() {
                    out.push(imported[j])
                    j = j + 1
                }
            }
        } else {
            out.push(stmt)
        }
        i = i + 1
    }
    return out
}

int main() {
    print("Lency Self-hosted Compiler (v0.1.0)\n")
    
    // 解析命令行参数
    var args = parse_args()
    
    if args.input_file == "" {
        print("Usage: lencyc <input_file> [-o <output_file>] [--check-only] [--emit-lir]\n")
        return 1
    }

    print("Target file: " + args.input_file + "\n")

    print("Stage 1/4: Reading source...\n")
    var source = read_to_string(args.input_file)

    print("Stage 2/4: Lexing...\n")
    var lexer = make_lexer(source)
    var token_count = 0
    while true {
        var token = lexer.scan_token()
        token_count = token_count + 1
        if token.kind == T_ERROR() {
            print("Lex failed at " + int_to_string(token.line) + ":" + int_to_string(token.column) + ": " + token.lexeme + "\n")
            return 1
        }
        if token.kind == T_EOF() {
            break
        }
    }
    print("Lexed tokens: " + int_to_string(token_count) + "\n")

    print("Stage 3/4: Parsing...\n")
    var parser = make_parser(source)
    var program = parser.parse_program()
    if parser.has_error {
        print("Parse failed.\n")
        return 1
    }
    var statements = program.statements
    print("Parsed statements: " + int_to_string(statements.len()) + "\n")

    print("Stage 4/4: Resolving names...\n")
    var resolve_result = resolve_program(program)
    if resolve_result.has_error {
        print("Resolve failed with " + int_to_string(resolve_result.error_count) + " errors.\n")
        return 1
    }
    print("Resolve passed.\n")

    if args.check_only {
        print("Check-only mode: pipeline completed without emit.\n")
        return 0
    }

    var emit_text = ""
    if args.emit_lir {
        var compilation_statements = load_compilation_statements(args.input_file, vec[])
        var emit_result = emit_lir_program(compilation_statements)
        if emit_result.has_error {
            print("LIR emit failed with " + int_to_string(emit_result.error_count) + " errors.\n")
            return 1
        }
        emit_text = emit_result.text
    } else {
        // Bootstrap emit target: stable AST text output for regression and debugging.
        emit_text = render_ast_program(statements)
    }

    write_string(args.output_file, emit_text)
    print("Emit output: " + args.output_file + "\n")
    print("Pipeline completed successfully.\n")

    return 0
}
