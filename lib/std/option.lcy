// Lency 标准库 - Option 模块 (option.lcy)
// 提供 Option<T> 类型的文档说明和辅助函数
//
// Option<T> 由 std.core 定义:
//   enum Option<T> {
//       Some(T),
//       None
//   }
//
// Option 没有编译器内置方法；需要取值时使用 match。
// `T?` 是独立的 nullable 类型，不是 Option 的语法糖。
//
// match 解构：
//   match opt {
//       case Option.Some(v) => // 使用 v
//       case Option.None => // 空值处理
//   }

import std.core

// 将 Option<int> 转换为可读字符串（调试用）
string option_int_to_string(int? v) {
    if v != null {
        return "Some(" + int_to_string(v) + ")"
    }
    return "None"
}

// 将 Option<string> 转换为可读字符串（调试用）
string option_string_to_string(string? v) {
    if v != null {
        return "Some(" + v + ")"
    }
    return "None"
}
