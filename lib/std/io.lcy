// Lency 标准库 - I/O 模块 (io.lcy)
// 提供文件和控制台 I/O 功能
//
// 注意：read_file, write_file, print, len, trim, split, join, substr
// 是编译器内置函数 (intrinsics)，不需要在这里定义。
// 本文件提供更高级的 I/O 抽象。

import std.core

// ============== 控制台输出 ==============

void println(string s) {
    print(s)
    print("\n")
}

// 打印整数 (不换行)
void print_int(int n) {
    print(n)
}

// 打印浮点数 (不换行)
void print_float(float f) {
    print(f)
}

// 打印整数并换行
void println_int(int n) {
    print(n)
    print("\n")
}

// 打印布尔值并换行
void println_bool(bool b) {
    if b {
        print("true\n")
    } else {
        print("false\n")
    }
}

// ============== 文件操作 ==============

// 读取文件的所有行
Vec<string> read_lines(string path) {
    var content = read_file(path)
    var lines = split(content, "\n")
    free(content)
    return lines
}

// 写入多行到文件
void write_lines(string path, Vec<string> lines) {
    var content = join(lines, "\n")
    write_file(path, content)
    free(content)
}

// 追加内容到文件
void append_file(string path, string content) {
    var existing = read_file(path)
    var combined = existing + content
    write_file(path, combined)
    free(existing)
    free(combined)
}

// ============== 路径操作 ==============

// 路径输入为借用；路径查询和拼接始终返回独立字符串，由调用者释放。
// 获取文件扩展名 (不含点)
string get_extension(string path) {
    var start = 0
    var dot = -1
    var i = 0
    while i < len(path) {
        if path[i] == 47 || path[i] == 92 {
            start = i + 1
            dot = -1
        } else {
            if path[i] == 46 { dot = i }
        }
        i = i + 1
    }
    if dot <= start { return substr("", 0, 0) }
    return substr(path, dot + 1, len(path) - dot - 1)
}

// 获取文件名 (不含路径)
string get_filename(string path) {
    var start = 0
    var i = 0
    while i < len(path) {
        if path[i] == 47 || path[i] == 92 { start = i + 1 }
        i = i + 1
    }
    return substr(path, start, len(path) - start)
}

// 获取目录路径 (不含文件名)
string get_directory(string path) {
    var end = -1
    var i = 0
    while i < len(path) {
        if path[i] == 47 || path[i] == 92 { end = i }
        i = i + 1
    }
    if end < 0 { return substr("", 0, 0) }
    if end == 0 { return substr(path, 0, 1) }
    return substr(path, 0, end)
}

// 拼接路径
string join_path(string base, string path) {
    if len(base) == 0 {
        return substr(path, 0, len(path))
    }
    if len(path) == 0 {
        return substr(base, 0, len(base))
    }
    // 检查 base 是否以 / 结尾
    var base_len = len(base)
    var last_char = base[base_len - 1]
    if last_char == 47 || last_char == 92 {
        return base + path
    }
    var prefix = base + "/"
    var result = prefix + path
    free(prefix)
    return result
}

// ============== 已实现的内置函数 (供参考) ==============
//
// 文件 I/O:
//   string read_file(string path) - 读取文件全部内容，失败时 panic
//   void write_file(string path, string content) - 写入文件，失败时 panic
//
// 控制台输出:
//   void print(any value)  - 打印到标准输出
//
// 字符串操作:
//   int     len(string s)                    - 字符串长度
//   string  trim(string s)                   - 去除首尾空白
//   Vec<string> split(string s, string delim) - 按分隔符拆分
//   string  join(Vec<string> parts, string sep) - 用分隔符连接
//   string  substr(string s, int start, int len) - 提取子串
