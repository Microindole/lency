// 字符串增强功能测试
import std.core
import std.str

int main() {
    print("String Enhanced Test\n")

    // 1. count
    var n = count("abcabcabc", "abc")
    print("count(abcabcabc, abc) = ")
    print(n) // 3
    print("\n")

    // 2. trim_left
    var s1 = trim_left("  hello  ")
    print("trim_left = [")
    print(s1) // "hello  "
    print("]\n")

    // 3. trim_right
    var s2 = trim_right("  hello  ")
    print("trim_right = [")
    print(s2) // "  hello"
    print("]\n")

    // 4. char_at
    var c = char_at("hello", 1) // 'e' = 101
    print("char_at(hello, 1) = ")
    print(c)
    print("\n")

    // 越界 panic 由 stage0 的失败用例验证。
    if char_at("hello", 4) != 111 { return 1 }

    // 5. last_index_of
    var idx = last_index_of("abcabc", "abc")
    print("last_index_of(abcabc, abc) = ")
    print(idx) // 3
    print("\n")

    print("String enhanced tests passed!\n")
    free(s1)
    free(s2)
    return 0
}
