// Option is an ordinary user enum. It has no name-based compiler methods.

enum Option<T> {
    Some(T),
    None
}

int main() {
    var some_val = Option<int>.Some(42);
    var none_val = Option<int>.None;

    var some_value = match some_val {
        case Option.Some(value) => value,
        case Option.None => 0
    }
    if some_value != 42 { return 1; }

    var none_value = match none_val {
        case Option.Some(value) => value,
        case Option.None => 100
    }
    if none_value != 100 { return 2; }

    // Print success
    print("Ordinary Option enum test passed!\n");
    return 0;
}
