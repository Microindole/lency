// Basic Null Safety Syntax Test

struct User {
    string name
}

void main() {
    print("Testing Null Safety Syntax...");

    // 1. Elvis Operator
    string? s = null;
    print(s ?? "default"); // Expected: "default"

    // 2. Safe Navigation
    User? u = null;
    // print(u?.name); // Lency Runtime print(null) support might be shaky?
    // Let's assume print handles it or check flow.
    
    // 3. Safe Navigation with property access
    string? name = u?.name;
    
    // 4. Chaining / Non-null
    User u_safe = User { name: "Safe" };
    User? u2 = u_safe;
    print(u2?.name ?? "No Name"); // Expected: "Safe"
}
