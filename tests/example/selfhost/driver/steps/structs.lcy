// tests/example/selfhost/driver/steps/structs.lcy
// Struct declaration step checks split from test_entry to keep file size under meta limits.

import std.core
import std.str
import tests.example.selfhost.driver.test_cases
import tests.example.selfhost.driver.test_support
import lencyc.syntax.parser
import lencyc.syntax.ast
import lencyc.syntax.token
import lencyc.codegen.lir

bool run_struct_field_declaration_tests() {
    print("Step 25: Struct field declaration parsing and semantic tests...\n")
    var source = src_parser_struct_fields_program()
    var parser = make_parser(source)
    var program = parser.parse_program()
    if parser.has_error {
        print("Struct field declaration parse failed unexpectedly.\n")
        return false
    }
    if program.statements.len() < 1 || program.statements[0].kind != STMT_STRUCT() {
        print("Struct field declaration AST kind mismatch.\n")
        return false
    }
    var struct_stmt = program.statements[0]
    var struct_decl = stmt_to_decl(struct_stmt)
    if struct_decl.struct_fields.len() != 3 {
        print("Struct field declaration count mismatch.\n")
        return false
    }
    if struct_decl.struct_fields[0].type_ref.kind != T_INT() || struct_decl.struct_fields[0].name.lexeme != "id" {
        print("Struct field #1 mismatch.\n")
        return false
    }
    if struct_decl.struct_fields[1].type_ref.kind != T_STRING() || struct_decl.struct_fields[1].name.lexeme != "name" {
        print("Struct field #2 mismatch.\n")
        return false
    }
    if struct_decl.struct_fields[2].type_ref.kind != T_FLOAT() || struct_decl.struct_fields[2].name.lexeme != "score" {
        print("Struct field #3 mismatch.\n")
        return false
    }
    if !contains(stmt_to_string(struct_stmt), "(struct Boxed [int id, string name, float score])") {
        print("Struct field declaration AST shape mismatch.\n")
        return false
    }
    var literal_source = src_parser_struct_literal_program()
    var literal_parser = make_parser(literal_source)
    var literal_program = literal_parser.parse_program()
    if literal_parser.has_error {
        print("Struct literal parse failed unexpectedly.\n")
        return false
    }
    if literal_program.statements.len() < 2 || literal_program.statements[1].kind != STMT_VAR_DECL() {
        print("Struct literal AST kind mismatch.\n")
        return false
    }
    if !contains(stmt_to_string(literal_program.statements[1]), "(var p = (struct Pair {left: 1, right: 2}))") {
        print("Struct literal AST shape mismatch.\n")
        return false
    }
    if !expect_shared_resolve_success(src_resolver_struct_literal_ok(), "struct literal/member access positive") {
        return false
    }
    if !expect_shared_resolve_error(src_resolver_struct_duplicate_field_bad(), "type duplicate field negative") {
        return false
    }
    if !expect_shared_resolve_error(src_resolver_struct_unknown_field_type_bad(), "type unknown field type negative") {
        return false
    }
    if !expect_shared_resolve_error(src_resolver_struct_literal_missing_field_bad(), "struct literal missing field negative") {
        return false
    }
    if !expect_shared_resolve_error(src_resolver_struct_literal_type_bad(), "struct literal type mismatch negative") {
        return false
    }
    if !expect_shared_resolve_error(src_resolver_struct_field_assign_type_bad(), "struct field assignment type mismatch negative") {
        return false
    }
    var empty_struct_parser = make_parser("struct Marker<T> {\n}\nMarker<int>? keep(Marker<int>? value) {\n  return value\n}\nreturn 0")
    var empty_struct_program = empty_struct_parser.parse_program()
    if empty_struct_parser.has_error {
        print("Empty struct ABI regression case failed to parse.\n")
        return false
    }
    var empty_struct_emit = emit_lir_program(empty_struct_program.statements)
    if empty_struct_emit.has_error || !contains(empty_struct_emit.text, "func keep(%value: ptr) -> ptr {") {
        print("Declared generic nullable empty struct did not lower to pointer ABI.\n")
        return false
    }
    var unknown_abi_parser = make_parser("Mystery keep(Mystery value) {\n  return value\n}\nreturn 0")
    var unknown_abi_program = unknown_abi_parser.parse_program()
    if unknown_abi_parser.has_error {
        print("Unknown ABI regression case failed to parse.\n")
        return false
    }
    var unknown_abi_emit = emit_lir_program(unknown_abi_program.statements)
    if !unknown_abi_emit.has_error || unknown_abi_emit.error_count != 2 {
        print("Unknown function ABI types did not report both parameter and return errors.\n")
        return false
    }
    if unknown_abi_emit.text != "" {
        print("Unknown function ABI types returned partial LIR output.\n")
        return false
    }
    return true
}
