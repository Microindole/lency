// tests/example/selfhost/driver/steps/resolver_defense.lcy
// Resolver defensive and signature precedence checks split from test_entry.

import std.core
import lencyc.syntax.ast
import lencyc.syntax.token
import lencyc.sema.resolver

bool run_resolver_preload_defensive_tests() {
    print("Step 11.5: Resolver declaration preload defensive tests...\n")
    var invalid_decl_program = make_program(vec[make_decl_base(DECL_UNKNOWN())], vec[])
    var invalid_decl_result = resolve_program(invalid_decl_program)
    if !invalid_decl_result.has_error {
        print("Resolver defensive test failed: DECL_UNKNOWN preload should report error.\n")
        return false
    }
    print("Resolver defensive test passed: DECL_UNKNOWN preload reports error.\n")
    var mismatch_stmt = make_stmt_function(
        make_token(T_IDENTIFIER(), "foo", 1, 1),
        make_type_ref(TYPE_UNKNOWN(), "int"),
        vec[],
        vec[],
        vec[]
    )
    mismatch_stmt.decl.kind = DECL_STRUCT()
    if !has_decl_payload_mismatch(mismatch_stmt) {
        print("Decl payload mismatch defensive test failed: mismatch should be detected.\n")
        return false
    }
    var mismatch_decl = stmt_to_decl(mismatch_stmt)
    if mismatch_decl.kind != DECL_UNKNOWN() {
        print("Decl payload mismatch defensive test failed: stmt_to_decl should return DECL_UNKNOWN.\n")
        return false
    }
    print("Decl payload mismatch defensive test passed.\n")
    var sig_resolver = make_resolver()
    sig_resolver.preload_enum_variant_signature("Outcome", "Value", vec[TYPE_UNKNOWN()], vec["unknown"])
    sig_resolver.preload_enum_variant_signature("Outcome", "Value", vec[TYPE_INT()], vec["int"])
    if sig_resolver.lookup_enum_constructor_param_type("Value", 0) != TYPE_INT() {
        print("Signature precedence test failed: latest enum payload type should win.\n")
        return false
    }
    if sig_resolver.lookup_enum_constructor_param_type_name("Value", 0) != "int" {
        print("Signature precedence test failed: latest enum payload type-name should win.\n")
        return false
    }
    sig_resolver.function_signatures.push(
        make_function_signature("demo", TYPE_UNKNOWN(), vec[TYPE_UNKNOWN()], "unknown", vec["unknown"], "")
    )
    sig_resolver.function_signatures.push(
        make_function_signature("demo", TYPE_INT(), vec[TYPE_INT()], "int", vec["int"], "")
    )
    if sig_resolver.lookup_user_function_return_type("demo") != TYPE_INT() {
        print("Signature precedence test failed: latest function return type should win.\n")
        return false
    }
    if sig_resolver.lookup_user_function_param_type("demo", 0) != TYPE_INT() {
        print("Signature precedence test failed: latest function param type should win.\n")
        return false
    }
    var unsupported_expr = make_expr_literal(make_token(T_NUMBER(), "1", 1, 1))
    unsupported_expr.kind = 999
    sig_resolver.resolve_expr(unsupported_expr)
    if !sig_resolver.has_error {
        print("Resolver defensive test failed: unsupported expression kind should report error.\n")
        return false
    }
    var malformed_resolver = make_resolver()
    malformed_resolver.resolve_expr(make_expr_literal(make_token(T_ERROR(), "", 1, 1)))
    var malformed_assign = make_expr_assign(make_token(T_IDENTIFIER(), "x", 1, 1), make_expr_literal(make_token(T_NUMBER(), "1", 1, 1)))
    malformed_assign.children = vec[]
    malformed_resolver.resolve_expr(malformed_assign)
    var malformed_set = make_expr_set(
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1)),
        make_token(T_IDENTIFIER(), "value", 1, 1),
        make_expr_literal(make_token(T_NUMBER(), "2", 1, 1))
    )
    malformed_set.children = vec[]
    malformed_resolver.resolve_expr(malformed_set)
    var malformed_get = make_expr_get(
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1)),
        make_token(T_IDENTIFIER(), "value", 1, 1)
    )
    malformed_get.children = vec[]
    malformed_resolver.resolve_expr(malformed_get)
    var malformed_unary = make_expr_unary(
        make_token(T_MINUS(), "-", 1, 1),
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1))
    )
    malformed_unary.children = vec[]
    malformed_resolver.resolve_expr(malformed_unary)
    malformed_resolver.resolve_expr(make_expr_unary(
        make_token(T_PLUS(), "+", 1, 1),
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1))
    ))
    var malformed_binary = make_expr_binary(
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1)),
        make_token(T_PLUS(), "+", 1, 1),
        make_expr_literal(make_token(T_NUMBER(), "2", 1, 1))
    )
    malformed_binary.children = vec[]
    malformed_resolver.resolve_expr(malformed_binary)
    malformed_resolver.resolve_expr(make_expr_binary(
        make_expr_literal(make_token(T_NUMBER(), "1", 1, 1)),
        make_token(T_BANG(), "!", 1, 1),
        make_expr_literal(make_token(T_NUMBER(), "2", 1, 1))
    ))
    var malformed_call = make_expr_call(
        make_expr_variable(make_token(T_IDENTIFIER(), "demo", 1, 1)),
        vec[]
    )
    malformed_call.children = vec[]
    malformed_resolver.resolve_expr(malformed_call)
    if malformed_resolver.error_count != 9 {
        print("Resolver defensive test failed: malformed expressions should each report one error.\n")
        return false
    }
    sig_resolver.function_signatures.push(
        make_function_signature("demo_enum", TYPE_NAMED(), vec[], "Status", vec[], "")
    )
    sig_resolver.function_signatures.push(
        make_function_signature("demo_enum", TYPE_NAMED(), vec[], "Status", vec[], "Status")
    )
    if sig_resolver.lookup_user_function_return_enum_name("demo_enum") != "Status" {
        print("Signature precedence test failed: latest function return enum-name should win.\n")
        return false
    }
    print("Signature precedence test passed.\n")
    return true
}
