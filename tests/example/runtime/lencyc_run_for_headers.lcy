// 三段式循环的分隔形式、作用域及嵌套跳转通过自举 LIR 执行。
// @expect-exit: 0
int main() {
    var sum = 0
    int i = 20
    for (int i = 0; i < 3; i = i + 1) { sum = sum + i }
    for (int i = 0 i < 3; i = i + 1) { sum = sum + i }
    for (int i = 0; i < 3 i = i + 1) { sum = sum + i }
    for (int i = 0 i < 3 i = i + 1) { sum = sum + i }
    for int i = 0; i < 3; i = i + 1 { sum = sum + i }
    for int i = 0 i < 3; i = i + 1 { sum = sum + i }
    for int i = 0; i < 3 i = i + 1 { sum = sum + i }
    for int i = 0 i < 3 i = i + 1 { sum = sum + i }
    if sum != 24 || i != 20 { return 1 }

    var updates = 0
    var visits = 0
    for (var n = 0 n < 5 updates = updates + 1) {
        n = n + 1
        if n == 2 { continue }
        if n == 4 { break }
        visits = visits + 1
    }
    if updates != 3 || visits != 2 { return 2 }

    var inner_visits = 0
    var outer_visits = 0
    for (var outer = 0; outer < 3; outer = outer + 1) {
        for int inner = 0 inner < 4 inner = inner + 1 {
            if inner == 1 { continue }
            if inner == 3 { break }
            inner_visits = inner_visits + 1
        }
        var n = 0
        while n < 2 {
            n = n + 1
            if n == 1 { continue }
            outer_visits = outer_visits + 1
        }
        if outer == 1 { continue }
        outer_visits = outer_visits + 1
    }
    if inner_visits != 6 || outer_visits != 5 { return 3 }
    for (i = 0 i < 2 i = i + 1) { sum = sum + i }
    if i != 2 || sum != 25 { return 4 }
    for (int never = 0; never < 0; never = never + 1) { return 5 }
    return 0
}
