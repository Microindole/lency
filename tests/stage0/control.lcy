int factorial(int n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

bool even(int n) {
    if n == 0 { return true }
    return odd(n - 1)
}

bool odd(int n) {
    if n == 0 { return false }
    return even(n - 1)
}

struct Counter { int value }
int tick(Counter state) {
    state.value = state.value + 1
    return state.value
}
int combine(int left, int right) { return left * 10 + right }
void noop() {}

int main() {
    noop()
    if factorial(6) != 720 || !even(12) || !odd(11) { return 1 }
    int total = 0
    for (int i = 0; i < 8; i = i + 1) {
        if i == 2 { continue }
        if i == 6 { break }
        total = total + i
    }
    if total != 13 { return 2 }
    int nested = 0
    for int i = 0 i < 3 i = i + 1 {
        int j = 0
        while j < 4 {
            j = j + 1
            if j == 2 { continue }
            if j == 4 { break }
            nested = nested + 1
        }
    }
    if nested != 6 { return 3 }
    int outer = 7
    { int outer = 3 if outer != 3 { return 4 } }
    if outer != 7 { return 5 }
    var counter = Counter { value: 0 }
    int ordered = combine(tick(counter), tick(counter))
    if ordered != 12 || counter.value != 2 { return 6 }
    if false && tick(counter) > 0 { return 7 }
    if !(true || tick(counter) > 0) { return 8 }
    int count = counter.value
    free(counter)
    if count != 2 { return 9 }
    print("stage0 control ok")
    return 0
}
